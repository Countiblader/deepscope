# -------------------------------------------------------
# DeepScope Server - Environment Variables
# Copy this file to .env and fill in your values
# -------------------------------------------------------

# AIS Stream API Key (free tier available)
# Sign up at: https://aisstream.io
# Free beta access, WebSocket stream for real-time ship positions
AISSTREAM_API_KEY=your_aisstream_key_here

# EIA API Key (optional - Yahoo Finance is used as free fallback)
# Sign up at: https://www.eia.gov/opendata/
# Provides official US government petroleum price data
EIA_API_KEY=your_eia_key_here

# ClickHouse Database (optional - in-memory fallback if not running)
# Default password is for local development only - change for production!
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=deepscope
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change_me_for_production

# Server port
PORT=4000
